{
  "name": "dsh-session-done-notifier",
  "version": "0.2.0",
  "description": "Bottom-right desktop popups with an optional Windows chime when a DSH session finishes, asks a question, or waits for approval, including while the window is minimized or in the tray.",
  "license": "MIT",
  "author": "little-bird-vodka",
  "repository": {
    "type": "git",
    "url": "https://github.com/little-bird-vodka/dsh-session-done-notifier.git"
  },
  "homepage": "https://github.com/little-bird-vodka/dsh-session-done-notifier#readme",
  "bugs": {
    "url": "https://github.com/little-bird-vodka/dsh-session-done-notifier/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/popup.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
